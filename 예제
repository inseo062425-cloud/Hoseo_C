#define _CRT_SECURE_NO_SWARNINGS
#include <stdio.h>

int main()
{
    int s1,s2,s3,s4; /*학생점수*/
    int a1,a2,a3,a4; /*절댓값*/
    int min,min_1,min_2,max,max_1,max_2,abs; /*최소,최대,절댓값*/
    float mean,var; /*평균,분산*/
    

    printf("\n 학생점수 입력(-100~+100):");
    scanf("%d %d %d %d",&s1,&s2,&s3,&s4);
    
    a1 = (s1<0)? -s1:s1;
    a2 = (s2<0)? -s2:s2;
    a3 = (s3<0)? -s3:s3;
    a4 = (s4<0)? -s4:s4;
    printf("\n 시험 점수 절댓값:%d %d %d %d",a1,a2,a3,a4);

    max_1 = (a1 > a2) ? a1 : a2;
    max_2 = (a3 > a4) ? a3 : a4;
    max = max_1 > max_2 ? max_1 : max_2;
    printf("\n 최대값:%d",max);

    min_1 = (a1 <a2) ? a1 : a2;
    min_2 = (a3< a4) ? a3 : a4;
    min = min_1 < min_2 ? min_1 : min_2;
    printf("\n 최소값: %d",min);

    mean = (s1+s2+s3+s4)/ 4.0;
    printf("\n 평균값: %.2f",mean);

    var = ((s1-mean)*(s1-mean)+(s2-mean)*(s2-mean)+(s3-mean)*(s3-mean)+(s4-mean)*(s4-mean))/3.0;
    printf("\n 분산값: %.2f",var);
    return 0;
}
